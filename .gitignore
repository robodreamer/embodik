.ninja_deps
.ninja_log
*.ninja

# scikit-build-core artifacts
.skbuild/
.skbuild-info.json
dist/
*.egg-info/

# Build directories
build/
install/

# Compiled libraries and binaries
*.so
*.a
*.dylib
*.dll
*.exe

