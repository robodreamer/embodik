      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/left_knuckle.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_knuckle_left_joint" type="fixed">
    <origin xyz="0.03060114 0 0.05490452" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_knuckle_left"/>
  </joint>

  <link name="right_gripper_visual_knuckle_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/right_knuckle.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_knuckle_right_joint" type="fixed">
    <origin xyz="-0.03060114 0 0.05490452" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_knuckle_right"/>
  </joint>

  <link name="right_gripper_visual_finger_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/left_finger.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_finger_left_joint" type="fixed">
    <origin xyz="0.062127 0 0.051141" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_finger_left"/>
  </joint>

  <link name="right_gripper_visual_finger_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/right_finger.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_finger_right_joint" type="fixed">
    <origin xyz="-0.062127 0 0.051141" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_finger_right"/>
  </joint>

  <link name="right_gripper_visual_inner_knuckle_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/left_inner_knuckle.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_inner_knuckle_left_joint" type="fixed">
    <origin xyz="0.0127 0 0.06142" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_inner_knuckle_left"/>
  </joint>

  <link name="right_gripper_visual_inner_knuckle_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/right_inner_knuckle.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_gripper_visual_inner_knuckle_right_joint" type="fixed">
    <origin xyz="-0.0127 0 0.06142" rpy="0 0 0"/>
    <parent link="right_gripper_visual_base"/>
    <child link="right_gripper_visual_inner_knuckle_right"/>
  </joint>

  <link name="right_finger_frame"/>
  <joint name="right_finger_frame_joint" type="fixed">
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <parent link="right_gripper_frame"/>
    <child link="right_finger_frame"/>
  </joint>

  <!-- Finger tips (alpha-specific STL meshes) -->
  <link name="right_gripper_visual_finger_tip_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/alpha_left_finger_tip.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 0.0 1" />
      </material>
    </visual>
  </link>
  <joint name="right_gripper_visual_finger_tip_left_joint" type="fixed">
    <origin xyz="0.00563134 0 0.04718515" rpy="0 0 0"/>
    <parent link="right_gripper_visual_finger_left"/>
    <child link="right_gripper_visual_finger_tip_left"/>
  </joint>

  <link name="right_gripper_visual_finger_tip_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://alpha_description/robotiq_gripper/meshes/visual/2f_85/alpha_right_finger_tip.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 0.0 1" />
      </material>
    </visual>
  </link>
  <joint name="right_gripper_visual_finger_tip_right_joint" type="fixed">
    <origin xyz="-0.00563134 0 0.04718515" rpy="0 0 0"/>
    <parent link="right_gripper_visual_finger_right"/>
    <child link="right_gripper_visual_finger_tip_right"/>
  </joint>
  </xacro:macro>
</robot>
